ALLOWED_DOMAIN=empresa.com
ADMIN_EMAIL=admin@empresa.com
# Obligatorio en producción (Docker): usa una cadena larga aleatoria
SESSION_SECRET=cambia-esto
PORT=3000
COOKIE_SECURE=false

# Inicio de sesión con IMAP (opcional). Si IMAP_HOST está definido, se valida
# el correo y contraseña contra el servidor de correo de la empresa.
# IMAP_HOST=imap.empresa.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER_FORMAT=email   # o "local" para usar solo la parte antes de @
# IMAP_TLS_REJECT_UNAUTHORIZED=true

# Avisos por correo (opcional). Si SMTP_HOST está definido se envían notificaciones.
# SMTP_HOST=smtp.empresa.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true para el puerto 465 (TLS directo)
# SMTP_USER=ti@empresa.com
# SMTP_PASS=
# SMTP_FROM=E-Ticket TI <ti@empresa.com>
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# APP_URL=https://tickets.empresa.com   # para los enlaces dentro de los correos

# Adjuntos (opcional)
# UPLOAD_DIR=./data/uploads
# MAX_UPLOAD_MB=10

# Detrás de un proxy HTTPS
# COOKIE_SECURE=true
# TRUST_PROXY=true

# Objetivos de tiempo en horas (opcional)
# SLA_JSON={"alta":{"response":2,"resolve":6}}
