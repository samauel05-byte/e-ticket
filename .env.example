ALLOWED_DOMAIN=empresa.com
ADMIN_EMAIL=admin@empresa.com
# Obligatorio en producción (Docker): usa una cadena larga aleatoria
SESSION_SECRET=cambia-esto
PORT=3000
# Con Docker + Caddy (HTTPS) deja ambas en true. Para probar en local con http://, pon COOKIE_SECURE=false.
COOKIE_SECURE=true
TRUST_PROXY=true

# Inicio de sesión con IMAP (opcional). Si IMAP_HOST está definido, se valida
# el correo y contraseña contra el servidor de correo de la empresa.
# IMAP_HOST=imap.empresa.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER_FORMAT=email   # o "local" para usar solo la parte antes de @
# IMAP_TLS_REJECT_UNAUTHORIZED=true

# Avisos por correo (opcional). Si SMTP_HOST está definido se envían notificaciones.
# SMTP_HOST=smtp.empresa.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true para el puerto 465 (TLS directo)
# SMTP_USER=ti@empresa.com
# SMTP_PASS=
# SMTP_FROM=ETIQUE <ti@empresa.com>

# Avisos de ticket nuevo: además de los técnicos/administradores, también se avisa a estos correos (separados por coma),
# por ejemplo al encargado de Tecnología, para que asigne el ticket. Requiere SMTP configurado.
# NOTIFY_NEW_TO=jefe.ti@empresa.com
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# APP_URL=https://tickets.empresa.com   # para los enlaces dentro de los correos

# Adjuntos (opcional)
# UPLOAD_DIR=./data/uploads
# MAX_UPLOAD_MB=10



# SLA en horario laboral
# Define tu zona horaria (en Docker el servidor usa UTC por defecto), p. ej.:
# SLA_TZ=America/Bogota
# WORK_START=08:00
# WORK_END=18:00
# WORK_DAYS=1,2,3,4,5
# SLA_HOLIDAYS=2026-12-25,2027-01-01
# LUNCH_SHIFTS={"A":["12:00","13:00"],"B":["13:00","14:30"]}
# SLA_JSON={"alta":{"response":2,"resolve":6}}

# Docker + Caddy (HTTPS)
# SITE_ADDRESS=tickets.empresa.local
# CADDY_TLS=internal      # o: /certs/cert.pem /certs/key.pem   o: correo@empresa.com (Let's Encrypt)

# Publicar en internet (ver DEPLOY.md, sección 7)
# LOGIN_MAX_PER_IP=20
# LOGIN_MAX_PER_EMAIL=8
# LOGIN_WINDOW_MIN=15
# LOGIN_FAIL_DELAY_MS=400
# IMAP_MAX_CONCURRENT=5
# INTERNAL_CIDRS=192.168.0.0/16,10.0.0.0/8   # Administración y Reportes solo desde la red interna

# Tickets por correo (opcional): los correos que lleguen a esta bandeja se convierten en tickets.
# La contraseña va SOLO aquí (nunca en el repositorio ni en el chat). Usa la misma cuenta para SMTP_USER/SMTP_FROM
# si quieres que los avisos salgan desde esa dirección y que la gente pueda responderlos.
# INBOX_HOST=imap.empresa.com
# INBOX_PORT=993
# INBOX_SECURE=true
# INBOX_USER=soporte@empresa.com
# INBOX_PASS=
# INBOX_POLL_SECONDS=60            # cada cuánto revisar (mínimo 5)
# INBOX_MAX_AGE_DAYS=2             # solo correos no leídos de los últimos N días (evita crear tickets del correo antiguo)
# INBOX_REQUIRE_AUTH=false         # true = exigir SPF/DKIM/DMARC "pass" del servidor de correo (anti-suplantación)
# INBOX_MAX_PER_SENDER_HOUR=20     # tope de tickets por correo, por remitente y hora
# INBOX_DEFAULT_PRIORITY=media

# Reabrir tickets: días después de resolver en los que el solicitante puede reabrirlo (0 = sin límite). TI siempre puede.
# REOPEN_DAYS=14
# Avisos de SLA por correo: % del tiempo consumido para avisar "por vencer" y cada cuántos minutos se revisa.
# SLA_WARN_PCT=80
# SLA_ALERT_MINUTES=10
